# Supabase project URL
# Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (public) key — safe for browser code
# Supabase Dashboard → Project Settings → API → publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key — SERVER ONLY, never expose to the browser
# Supabase Dashboard → Project Settings → API → secret key
SUPABASE_SECRET_KEY=

# OpenAI API key — SERVER ONLY, never expose to the browser
# OpenAI Dashboard → API Keys
OPENAI_API_KEY=

# OpenAI model for cover-letter generation — SERVER ONLY
# Falls back to OPENAI_EXTRACTION_MODEL, then gpt-5-mini
OPENAI_MODEL=

# Optional override for AeroDataBox via RapidAPI
# AERODATABOX_API_HOST=aerodatabox.p.rapidapi.com
# AERODATABOX_API_BASE_URL=https://aerodatabox.p.rapidapi.com

# AeroDataBox flight lookup API key — SERVER ONLY, never expose to the browser
# Sign up at https://rapid.aerodatabox.com or https://aerodatabox.com/pricing
AERODATABOX_API_KEY=
